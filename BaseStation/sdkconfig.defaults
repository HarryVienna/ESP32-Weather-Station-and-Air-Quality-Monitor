# --- Target ---
CONFIG_IDF_TARGET="esp32p4"

# --- Chip Revision (ESP32-P4 rev <3.0 and >=3.0 are mutually exclusive) ---
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y

# No reboot after panic
CONFIG_ESP_SYSTEM_PANIC_PRINT_HALT=y

# --- Flash ---
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# --- Partition Table ---
CONFIG_PARTITION_TABLE_CUSTOM=y

# --- OTA ---
# Auto-revert to the previous ota_0/ota_1 slot if the new app never confirms
# itself healthy (esp_ota_mark_app_valid_cancel_rollback() in main.c) - safety
# net for a device that isn't physically reachable if an update goes bad.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- Compiler ---
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# --- PSRAM ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# --- Cache (optimized for display performance) ---
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# --- FreeRTOS ---
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
CONFIG_ESP_TASK_WDT_EN
# Default (5s) is occasionally too tight for the synchronous ui_init() at
# boot (builds the whole EEZ screen tree without yielding) - WDT panic is
# off anyway, so this only silences a harmless warning, not a real hang.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# --- Experimental features (required for ESP32-P4 MIPI DSI) ---
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# --- Wi-Fi (ESP32-P4 has no native radio: routed to the on-board ESP32-C6 ---
# --- co-processor over ESP-Hosted/SDIO via esp_wifi_remote) ---
# NOTE: do NOT set CONFIG_ESP_HOST_WIFI_ENABLED=y here. Under IDF <6.0 that
# symbol didn't exist, so it was a harmless no-op left over from an older
# config. IDF 6.0 introduced its own *different*, unrelated "Host WiFi"
# feature under this exact same Kconfig name (esp_wifi/Kconfig), which is
# mutually exclusive with ESP_WIFI_REMOTE_ENABLED - enabling it silently
# disables the whole esp_wifi_remote/esp_hosted stack this project actually
# uses, leaving WiFi completely dead (no scan results, no connect).
#
# The two symbols below *should* default to "y" on their own once
# ESP_HOST_WIFI_ENABLED is off, but under IDF 6.0.2 they didn't come out that
# way after a full reconfigure (still resolved to "not set" as their computed
# default) - so they're set explicitly here instead of relying on that chain.
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y

# --- LVGL Configuration ---
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_USE_TRANSLATION=y
# Disabled: combined with LV_USE_SNAPSHOT this overflows IRAM
# CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM is not set
CONFIG_LV_USE_SNAPSHOT=y

# Fonts for LVGL
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_FONT_MONTSERRAT_48=y